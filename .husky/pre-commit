#!/usr/bin/env sh
# Execute the husky helper as a subprocess so its internal `exit` doesn't
# terminate this outer script (sourcing it with `.` can cause that).
sh "$(dirname "$0")/_/h"

# Fast pre-commit: lint/format staged files, then run affected unit and tool test tasks.
# --base=HEAD intentionally includes unstaged edits to shared libs (overly broad is safe).
# Backend integration/e2e, full coverage, and SonarCloud coverage merge all run in CI.
pnpm run lint-staged:run || exit 1

# Tests must not inherit this hook's repository. Git exports GIT_DIR and
# GIT_INDEX_FILE to hooks; a test that runs `git init` in a temp directory
# then re-initialises this repository instead, and from a linked worktree
# that sets `core.bare` on the main checkout.
unset $(git rev-parse --local-env-vars)
pnpm run test:pre-commit
