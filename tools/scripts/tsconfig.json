{
  "extends": "../tsconfig.tools.json",
  "compilerOptions": {
    // Scripts import plain TypeScript from libs (for example the locale list).
    "rootDir": "../..",
    "types": ["node", "vitest/globals"],
    "ignoreDeprecations": "6.0"
  },
  // Spec files are intentionally included so colocated script tests get Vitest globals.
  "include": ["**/*.ts"]
}
