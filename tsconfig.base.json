{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2021",
    "module": "esnext",
    "lib": ["es2023", "dom"],
    "types": ["vitest/globals", "node"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@data-access": ["libs/data-access/src/index.ts"],
      "@shared-styles": ["libs/shared-styles/src/index.ts"],
      "@ui": ["libs/ui/src/index.ts"],
      "@utils": ["libs/utils/src/index.ts"],
      "@spartan-ng/helm": ["./libs/ui-helm/src/index.ts"],
      "@spartan-ng/helm/button": ["./libs/ui-helm/button/src/index.ts"],
      "@spartan-ng/helm/utils": ["./libs/ui-helm/utils/src/index.ts"],
      "@spartan-ng/helm/card": ["./libs/ui-helm/card/src/index.ts"],
      "@spartan-ng/helm/table": ["./libs/ui-helm/table/src/index.ts"],
      "@spartan-ng/helm/dialog": ["./libs/ui-helm/dialog/src/index.ts"],
      "@spartan-ng/helm/switch": ["./libs/ui-helm/switch/src/index.ts"],
      "@spartan-ng/helm/input": ["./libs/ui-helm/input/src/index.ts"],
      "@spartan-ng/helm/alert": ["./libs/ui-helm/alert/src/index.ts"],
      "@spartan-ng/helm/separator": ["./libs/ui-helm/separator/src/index.ts"],
      "@spartan-ng/helm/spinner": ["./libs/ui-helm/spinner/src/index.ts"],
      "@spartan-ng/helm/carousel": ["./libs/ui-helm/carousel/src/index.ts"],
      "@spartan-ng/helm/label": ["./libs/ui-helm/label/src/index.ts"],
      "@spartan-ng/helm/native-select": [
        "./libs/ui-helm/native-select/src/index.ts"
      ],
      "@spartan-ng/helm/textarea": ["./libs/ui-helm/textarea/src/index.ts"]
    },
    "strict": false,
    "noUncheckedSideEffectImports": false,
    "esModuleInterop": false,
    "ignoreDeprecations": "6.0"
  },
  "exclude": ["node_modules", "tmp"]
}
