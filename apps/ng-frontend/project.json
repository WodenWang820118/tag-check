{
  "name": "ng-frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/ng-frontend/src",
  "tags": ["scope:frontend", "type:app"],
  "targets": {
    "typecheck-spec": {},
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/ng-frontend",
        "index": "apps/ng-frontend/src/index.html",
        "browser": "apps/ng-frontend/src/main.ts",
        "polyfills": ["zone.js", "@angular/localize/init"],
        "externalDependencies": ["marked-katex-extension"],
        "tsConfig": "apps/ng-frontend/tsconfig.app.json",
        "inlineStyleLanguage": "css",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/ng-frontend/public"
          },
          {
            "glob": "splash.html",
            "input": "apps/ng-frontend/src",
            "output": "/"
          },
          {
            "input": "libs/utils/src/lib/assets",
            "glob": "**/*",
            "output": "/assets/"
          }
        ],
        "styles": [
          "libs/shared-styles/src/prebuilt-theme-base.scss",
          "apps/ng-frontend/src/styles.css",
          "libs/shared-styles/src/index.scss",
          "node_modules/prismjs/themes/prism-okaidia.css",
          "node_modules/prismjs/plugins/command-line/prism-command-line.css"
        ],
        "scripts": [
          "node_modules/prismjs/prism.js",
          "node_modules/prismjs/components/prism-markup.min.js",
          "node_modules/prismjs/components/prism-javascript.min.js",
          "node_modules/prismjs/components/prism-typescript.min.js",
          "node_modules/prismjs/plugins/command-line/prism-command-line.js"
        ],
        "sourceMap": {
          "scripts": true,
          "styles": false,
          "hidden": true,
          "vendor": true
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "750kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/ng-frontend/src/environments/environment.ts",
              "with": "apps/ng-frontend/src/environments/environment.development.ts"
            }
          ]
        },
        "desktop": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/ng-frontend/src/environments/environment.ts",
              "with": "apps/ng-frontend/src/environments/environment.desktop.ts"
            }
          ]
        },
        "desktop-production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "750kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "removeSpecialComments": true,
              "inlineCritical": false
            },
            "fonts": true
          },
          "outputHashing": "all",
          "sourceMap": false,
          "fileReplacements": [
            {
              "replace": "apps/ng-frontend/src/environments/environment.ts",
              "with": "apps/ng-frontend/src/environments/environment.desktop.production.ts"
            }
          ]
        },
        "mock": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/ng-frontend/src/environments/environment.ts",
              "with": "apps/ng-frontend/src/environments/environment.mock.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "ng-frontend:build:production"
        },
        "development": {
          "buildTarget": "ng-frontend:build:development"
        },
        "desktop": {
          "buildTarget": "ng-frontend:build:desktop"
        },
        "desktop-production": {
          "buildTarget": "ng-frontend:build:desktop-production"
        },
        "mock": {
          "buildTarget": "ng-frontend:build:mock"
        },
        "staging": {
          "buildTarget": "ng-frontend:build:staging"
        }
      }
    },
    "mock": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "development": {
          "buildTarget": "ng-frontend:build:development",
          "fileReplacements": [
            {
              "replace": "apps/ng-frontend/src/environments/environment.ts",
              "with": "apps/ng-frontend/src/environments/environment.development.ts"
            }
          ]
        }
      }
    },
    "staging": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "development": {
          "buildTarget": "ng-frontend:build:development",
          "fileReplacements": [
            {
              "replace": "apps/ng-frontend/src/environments/environment.ts",
              "with": "apps/ng-frontend/src/environments/environment.staging.ts"
            }
          ]
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "ng-frontend:build"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "ng-frontend:build:development",
        "tsConfig": "apps/ng-frontend/tsconfig.spec.json",
        "runner": "vitest",
        "coverageReporters": ["lcov", "html"]
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "ng-frontend:build",
        "staticFilePath": "dist/apps/ng-frontend/browser"
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "continuous": true,
      "options": {
        "port": 4400,
        "configDir": "apps/ng-frontend/.storybook",
        "browserTarget": "ng-frontend:build:development",
        "tsConfig": "apps/ng-frontend/tsconfig.storybook.json",
        "sourceMap": false,
        "experimentalZoneless": false,
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "readyWhen": {
        "port": "{env.SBCONFIG_PORT ?? options.port ?? 9009}",
        "host": "{env.SBCONFIG_HOSTNAME ?? options.host ?? localhost}"
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "storybook-static",
        "configDir": "apps/ng-frontend/.storybook",
        "browserTarget": "ng-frontend:build:production",
        "tsConfig": "apps/ng-frontend/tsconfig.storybook.json",
        "experimentalZoneless": false,
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c apps/ng-frontend/.storybook --url=http://localhost:4400"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "ng-frontend:build-storybook",
        "staticFilePath": "storybook-static",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "ng-frontend:build-storybook:ci"
        }
      }
    }
  }
}
