{
  "extends": "./tsconfig.project.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": ["@angular/localize"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "**/*.d.ts", "../../libs/**/*.d.ts"],
  "exclude": [
    "out-tsc",
    "jest.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "**/*.stories.ts",
    "**/*.stories.js"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
