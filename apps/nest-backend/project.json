{
  "name": "nest-backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/nest-backend/src",
  "projectType": "application",
  "tags": ["scope:backend", "type:app"],
  "targets": {
    "typecheck-spec": {},
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "nest-backend:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "nest-backend:build:development"
        },
        "production": {
          "buildTarget": "nest-backend:build"
        }
      }
    },
    "test-unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest --root=apps/nest-backend --exclude=\"**/test/*e2e-spec.ts\" --exclude=\"**/*.integration.spec.ts\" --watch=false"
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest --root=apps/nest-backend --watch=false .integration.spec.ts"
      }
    },
    "test-coverage": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/nest-backend"],
      "options": {
        "command": "pnpm exec vitest --coverage --root=apps/nest-backend --exclude=\"**/test/*e2e-spec.ts\" --exclude=\"**/*.integration.spec.ts\" --watch=false"
      }
    },
    "test-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm exec vitest test/app.e2e-spec.ts --root=apps/nest-backend --watch=false"
      }
    },
    "test-e2e-coverage": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/coverage/apps/nest-backend-e2e"],
      "options": {
        "command": "pnpm exec vitest test/app.e2e-spec.ts --coverage --coverage.reportsDirectory=../../coverage/apps/nest-backend-e2e --root=apps/nest-backend --watch=false"
      }
    }
  }
}
