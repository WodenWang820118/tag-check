# Loaded by Nx for "nx build ng-gtm-sample --configuration production" (the Vercel build command).
# The 2-core, 8 GB Vercel build container OOM-killed this build. Static prerendering with the
# default worker pool plus esbuild peaked near 7.5 GB, and V8 and Go size their heaps from the
# host's memory rather than the container limit. Cap all three:
NG_BUILD_MAX_WORKERS=1
NODE_OPTIONS=--max-old-space-size=3072
GOMEMLIMIT=2GiB
